<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      로컬 개발용 HTTP 허용. 스토어 배포 전에는 HTTPS만 쓰고,
      필요 시 도메인 단위(domain-config)로 좁히는 것을 권장합니다.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
