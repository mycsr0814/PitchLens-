# ── 안드로이드 / 에뮬레이터에서 주의 ───────────────────────────────
#  • localhost·127.0.0.1 은 「폰/에뮬 자신」을 가리킵니다.
#    - 안드로이드 에뮬레이터 → PC에서 돌아가는 서버: http://10.0.2.2:포트
#    - 실제 폰(USB·같은 Wi‑Fi) → PC IPv4 주소 (예: http://192.168.0.12:포트)
#  • 변경 후에는 반드시 npm run cap:sync (웹 재빌드 포함) 할 것
#  • 백엔드(uvicorn 등)는 0.0.0.0 바인딩으로 외부에서 접속 가능해야 함

# 메인 사용자·발표 API (FastAPI)
REACT_APP_API_URL=http://10.0.2.2:8000

# 피드백/슬라이드 미리보기 API (presentation-feedback 등, 코드상 이 이름 사용)
REACT_APP_FEEDBACK_API_URL=http://10.0.2.2:8001

# (선택) 음성 분석 API가 별도일 때만 — 실제 포트로 맞출 것
# REACT_APP_VOICE_API_URL=http://10.0.2.2:8765
