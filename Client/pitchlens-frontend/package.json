{
  "name": "pitchlens",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@capacitor/core": "^7.6.4",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
